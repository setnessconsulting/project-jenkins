# Copy to .env and fill in the target-specific, non-secret wiring.
# Never put passwords, tokens, or private-key contents in this file.
JENKINS_TARGET_REPO_OWNER=your-owner
JENKINS_TARGET_REPO_NAME=your-private-repository
JENKINS_GITHUB_APP_ID=12345678
JENKINS_GITHUB_APP_CREDENTIAL_ID=github-app
# Optional portfolio dispatcher catalog. Leave blank to keep its Jenkins job disabled.
JENKINS_PORTFOLIO_CATALOG_REPOSITORY=
JENKINS_CHECKOUT_SSH_CREDENTIAL_ID=jenkins-readonly-checkout
JENKINS_MULTIBRANCH_JOB_NAME=jenkins-pilot
JENKINS_MARKER_FILE=app/package.json
JENKINS_CANDIDATE_PATHS=app/,.github/workflows/candidate-validation.yml
JENKINS_TUTOR_WEB_DIRECTORY=example-tutor-web
JENKINS_E2E_JOB_NAME=example-e2e
# Keep false during initial shadow while the GitHub Actions E2E schedule remains enabled.
JENKINS_E2E_SCHEDULE_ENABLED=false
JENKINS_PRIMARY_CHECK_NAME=required-ci
JENKINS_CANDIDATE_CHECK_NAME=candidate-validation
JENKINS_APP_DIRECTORY=app
JENKINS_SITE_URL=https://example.invalid
# Set to the Ubuntu VM's static host-only IP for the Hyper-V pilot. Keep the
# Windows-side port forward bound to 127.0.0.1 only.
JENKINS_HTTP_BIND_IP=192.168.218.2
JENKINS_HTTP_PORT=18080
# Manual Test Platform contract consumer job (API-390). No secrets here.
JENKINS_TEST_PLATFORM_JOB_NAME=test-platform-contract
JENKINS_TEST_PLATFORM_NODE=node
JENKINS_TEST_PLATFORM_ADAPTER_ROOT=/usr/share/jenkins/test-platform-contract
# Optional controller evidence publication root; empty disables publication.
JENKINS_TEST_PLATFORM_EVIDENCE_ROOT=

# Optional second-repository profile. Leave disabled until its GitHub App
# installation, repository-specific read-only checkout credential, and trusted
# PR-author allowlist have been reviewed. Never put secrets in this file.
JENKINS_SECONDARY_REPO_ENABLED=false
JENKINS_SECONDARY_REPO_OWNER=
JENKINS_SECONDARY_REPO_NAME=
JENKINS_SECONDARY_JOB_NAME=secondary-pilot
JENKINS_SECONDARY_CHECKOUT_CREDENTIAL_ID=secondary-readonly-checkout
JENKINS_SECONDARY_TRUSTED_PR_AUTHORS=
JENKINS_SECONDARY_PRIMARY_CHECK_NAME=jenkins-pr-gate
JENKINS_SECONDARY_SMOKE_CHECK_NAME=jenkins-production-smoke
JENKINS_SECONDARY_SMOKE_URL=
